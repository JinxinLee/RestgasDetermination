#!/bin/bash

SAMPLER="Topix4-sampler"
SAMPLER+=" --id sampler1"
SAMPLER+=" --config-json-file @CMAKE_BINARY_DIR@/bin/config/TopixChain.json"
xterm -geometry 80x23+0+150 -e @CMAKE_BINARY_DIR@/bin/$SAMPLER &

PROCESSOR="Topix4-processor"
PROCESSOR+=" --id processor1"
PROCESSOR+=" --config-json-file @CMAKE_BINARY_DIR@/bin/config/TopixChain.json"
xterm -geometry 80x23+500+150 -e @CMAKE_BINARY_DIR@/bin/$PROCESSOR &

DUPLICATOR="Topix4-duplicator"
DUPLICATOR+=" --id duplicator1"
DUPLICATOR+=" --config-json-file @CMAKE_BINARY_DIR@/bin/config/TopixChain.json"
xterm -geometry 80x23+1000+150 -e @CMAKE_BINARY_DIR@/bin/$DUPLICATOR &

DISTRIBUTOR="Topix4-distributor"
DISTRIBUTOR+=" --id distributor1"
DISTRIBUTOR+=" --config-json-file @CMAKE_BINARY_DIR@/bin/config/TopixChain.json"
xterm -geometry 80x23+500+200 -e @CMAKE_BINARY_DIR@/bin/$DISTRIBUTOR &

SORTER1="Topix4-sorter"
SORTER1+=" --id sorter1"
SORTER1+=" --config-json-file @CMAKE_BINARY_DIR@/bin/config/TopixChain.json"
xterm -geometry 80x23+0+500 -e @CMAKE_BINARY_DIR@/bin/$SORTER1 &

SORTER2="Topix4-sorter"
SORTER2+=" --id sorter2"
SORTER2+=" --config-json-file @CMAKE_BINARY_DIR@/bin/config/TopixChain.json"
xterm -geometry 80x23+500+500 -e @CMAKE_BINARY_DIR@/bin/$SORTER2 &

SORTER3="Topix4-sorter"
SORTER3+=" --id sorter3"
SORTER3+=" --config-json-file @CMAKE_BINARY_DIR@/bin/config/TopixChain.json"
xterm -geometry 80x23+1000+500 -e @CMAKE_BINARY_DIR@/bin/$SORTER3 &

MERGER="Topix4-merger"
MERGER+=" --id merger1"
MERGER+=" --config-json-file @CMAKE_BINARY_DIR@/bin/config/TopixChain.json"
xterm -geometry 80x23+0+850 -e @CMAKE_BINARY_DIR@/bin/$MERGER &

FILESINK="Topix4-filesink"
FILESINK+=" --id filesink1"
FILESINK+=" --config-json-file @CMAKE_BINARY_DIR@/bin/config/TopixChain.json"
xterm -geometry 80x23+500+850 -e @CMAKE_BINARY_DIR@/bin/$FILESINK &

ONLINE="Topix4-onlineHisto"
ONLINE+=" --id online1"
ONLINE+=" --config-json-file @CMAKE_BINARY_DIR@/bin/config/TopixChain.json"
xterm -geometry 80x23+0+200 -e @CMAKE_BINARY_DIR@/bin/$ONLINE &

wait
