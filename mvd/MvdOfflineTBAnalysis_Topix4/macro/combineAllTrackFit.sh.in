#!/bin/bash

SAMPLER="Topix4-hitsampler2"
SAMPLER+=" --id reader1"
SAMPLER+=" --InputFile ~/PandaSoftware/pandaRoot/build_pandaRoot_ActualTrunk/bin/HitsFE1.root"
SAMPLER+=" --mq-config @CMAKE_BINARY_DIR@/bin/config/CombineChainTrackFit.json"
xterm -geometry 80x23+0+150 -e @CMAKE_BINARY_DIR@/bin/$SAMPLER &

SAMPLER2="Topix4-hitsampler2"
SAMPLER2+=" --id reader2"
SAMPLER2+=" --InputFile ~/PandaSoftware/pandaRoot/build_pandaRoot_ActualTrunk/bin/HitsFE2.root"
SAMPLER2+=" --mq-config @CMAKE_BINARY_DIR@/bin/config/CombineChainTrackFit.json"
xterm -geometry 80x23+500+150 -e @CMAKE_BINARY_DIR@/bin/$SAMPLER2 &

SAMPLER3="Topix4-hitsampler2"
SAMPLER3+=" --id reader3"
SAMPLER3+=" --InputFile ~/PandaSoftware/pandaRoot/build_pandaRoot_ActualTrunk/bin/HitsFE3.root"
SAMPLER3+=" --mq-config @CMAKE_BINARY_DIR@/bin/config/CombineChainTrackFit.json"
xterm -geometry 80x23+1000+150 -e @CMAKE_BINARY_DIR@/bin/$SAMPLER3 &

SAMPLER4="Topix4-hitsampler2"
SAMPLER4+=" --id reader4"
SAMPLER4+=" --InputFile ~/PandaSoftware/pandaRoot/build_pandaRoot_ActualTrunk/bin/HitsFE4.root"
SAMPLER4+=" --mq-config @CMAKE_BINARY_DIR@/bin/config/CombineChainTrackFit.json"
xterm -geometry 80x23+0+500 -e @CMAKE_BINARY_DIR@/bin/$SAMPLER4 &

BUILDER="Topix4-hiteventbuilder"
BUILDER+=" --id builder1"
BUILDER+=" --mq-config @CMAKE_BINARY_DIR@/bin/config/CombineChainTrackFit.json"
xterm -geometry 80x23+500+500 -e @CMAKE_BINARY_DIR@/bin/$BUILDER >log.txt 2>&1 &

FITTER="Topix4-trackfitter"
FITTER+=" --id trackfit1"
FITTER+=" --mq-config @CMAKE_BINARY_DIR@/bin/config/CombineChainTrackFit.json"
xterm -sl 20000 -geometry 80x23+750+500 -e @CMAKE_BINARY_DIR@/bin/$FITTER >log.txt 2>&1 &

DUPLICATOR="Topix4-duplicator"
DUPLICATOR+=" --id duplicator1"
DUPLICATOR+=" --mq-config @CMAKE_BINARY_DIR@/bin/config/CombineChainTrackFit.json"
xterm -geometry 80x23+2000+500 -e @CMAKE_BINARY_DIR@/bin/$DUPLICATOR &

FILESINK="Topix4-filesinktracks"
FILESINK+=" --id filesinktracks"
FILESINK+=" --mq-config @CMAKE_BINARY_DIR@/bin/config/CombineChainTrackFit.json"
xterm -geometry 80x23+1000+500 -e @CMAKE_BINARY_DIR@/bin/$FILESINK &

FILESINK2="Topix4-filesinkhits"
FILESINK2+=" --id filesinkhits"
FILESINK2+=" --mq-config @CMAKE_BINARY_DIR@/bin/config/CombineChainTrackFit.json"
xterm -geometry 80x23+1500+500 -e @CMAKE_BINARY_DIR@/bin/$FILESINK2 &

wait
