#################################################################
# Digitisation and reconstruction parameters for TPC
# Format:
# parameter_name:parameter_type(i-integer, d-double) parameter_value
# TPCDigiPar
# Description of parameters
#################################################################
[PndTpcDigiPar]
PndTpcGasFile:Int_t 25
EField:Double_t 250
AttachFlag:Int_t 0
LogitudinaldiffusionFlag:Int_t 1
TransversediffusionFlag:Int_t 1
DriftDistortionFlag:Int_t 0
zGem:Double_t 0.
Gain:Double_t 5000
Spread:Double_t 0.015
MinSignalAmp:Double_t 0.
rMin:Double_t 0.
rMax:Double_t 20.
PadPlaneFile:Int_t 26
PadShapeFile:Int_t 27
PadShapeRange:Double_t 0.5
PadShapeStep:Double_t 0.02
PadShapeIntStep:Double_t 0.01
ADCThreshold:Int_t 0
ADCMax:Int_t 1000000
ADCBits:Int_t 10
SamplingFreq:Double_t 10
T0_wallclock:Double_t 0.
TimeBits:Int_t 28
PSAThreshold:Int_t 0
Shaper_tDiff:Double_t 300
Shaper_tInt:Double_t 300
Shaper_tSig:Double_t 5
TOTPSA:Int_t 1
GAUSSIANNOISE:Int_t 1
GAUSSIANNOISEAMP:Int_t 2000
#################################################################