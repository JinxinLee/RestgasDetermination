#################################################################
# Digitisation and reconstruction parameters for TPC
# Format:
# parameter_name:parameter_type(i-integer, d-double) parameter_value
# TPCDigiPar
# Description of parameters
#################################################################
[PndTpcDigiPar]
PndTpcGasFile:Int_t 34    #33: Ar/CO2 90/10 B=0.3; 34: Ne/CO2 90/10 B=0.6; 35: Ar/CO2 90/10 B=0.6;
EField:Double_t 360.
AttachFlag:Int_t 0
LogitudinaldiffusionFlag:Int_t 1
TransversediffusionFlag:Int_t 1
DriftDistortionFlag:Int_t 0
zGem:Double_t -62.5
zMax:Double_t  10.78
Gain:Double_t 4000
Supression:Double_t 0.001
Spread:Double_t 0.02
MinSignalAmp:Double_t 6   #used in PadResponseTask
rMin:Double_t 5.
rMax:Double_t 15.5
PadPlaneFile:Int_t 30
PadShapeFile:Int_t 32
PadShapeRange:Double_t 0.5
PadShapeStep:Double_t 0.02
PadShapeIntStep:Double_t 0.01
ADCThreshold:Int_t 2
ADCMax:Int_t 100000
ADCBits:Int_t 11
SamplingFreq:Double_t 20
T0_wallclock:Double_t 0 #1000 #-20000
TimeBits:Int_t 28
PSAThreshold:Int_t 6
Shaper_tDiff:Double_t 50
Shaper_tInt:Double_t 50
Shaper_tSig:Double_t 2
TOTPSA:Int_t 1
GAUSSIANNOISE:Int_t 0
GAUSSIANNOISEAMP:Int_t 0
Rate:Double_t 2e-2
#################################################################