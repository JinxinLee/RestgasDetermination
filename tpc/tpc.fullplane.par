#################################################################
# Digitisation and reconstruction parameters for TPC
# Format:
# parameter_name:parameter_type(i-integer, d-double) parameter_value
# TPCDigiPar
# Description of parameters
#################################################################
[PndTpcDigiPar]
PndTpcGasFile:i 0
EField:d 400
AttachFlag:i 0
LogitudinaldiffusionFlag:i 1
TransversediffusionFlag:i 1
DriftDistortionFlag:i 0
zGem:d -40
Gain:d 5000
Spread:d 0.02
MinSignalAmp:d 10
rMin:d 15
rMax:d 42
PadPlaneFile:i 24
PadShapeFile:i 14
PadShapeRange:d 0.5
PadShapeStep:d 0.02
PadShapeIntStep:d 0.01
ADCThreshold:i 10
ADCMax:i 100000
ADCBits:i 12
SamplingFreq:d 40
T0_wallclock:d -60000
TimeBits:i 28
PSAThreshold:i 100
Shaper_tDiff:d 50
Shaper_tInt:d 50
Shaper_tSig:d 2
TOTPSA:i 1
#################################################################