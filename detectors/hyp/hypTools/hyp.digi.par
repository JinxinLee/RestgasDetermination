#################################################################
# Digitization parameters for HYP
# Format:
# parameter_name:parameter_type(i-integer, d-double) parameter_value
# PndHypDigiPar
# Description of parameters:
#################################################################
#################################################################
# Digitization parameters for RECTANGULAR Hyp strip sensors
#################################################################
[HypStripDigiParRect]
top_pitch:Double_t 0.0120
bot_pitch:Double_t 0.0130
orient:Double_t 0
skew:Double_t 1.570796327
top_anchor_x:Double_t 0.
top_anchor_y:Double_t 0.
bot_anchor_x:Double_t 0.
bot_anchor_y:Double_t 0.
nr_fe_channels:Int_t 128
nr_fe_top:Int_t 10
nr_fe_bottom:Int_t 10
charge_threshold:Double_t 3000
charge_noise:Double_t 1000
sens_Type:Text_t Rect
fe_Type:Text_t APV25

