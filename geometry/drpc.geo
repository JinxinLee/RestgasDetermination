# A detailed DRPC TOF geometry
# by //Dr.Sys
# All geometry sizes in [cm]
# Sizes of the camera
CameraSizeX=5.0
CameraSizeZ=5.0
# Thickness of the anode
CameraAnodTh=0.05
# Thickness of the cathode
CameraCathodTh=0.1
# Thickness of sensitive gas layer
CameraGasTh=0.03
# Size of the spacer
CameraSpacerSize=0.2
# Number of camera layers
CameraLayers=4
# Size of dead zone on the camera
CameraDeadZone=0.2
# Camera holder geometry
# Thickness of holder
HolderTh=0.2
# Screw siz and position
HolderScrewR=0.3
HolderScrewX=1.10
HolderScrewZ=0.55
# Size of holder
HolderSizeX=4.0
# Size of bottom type of holder
HolderSizeX2=0.5
# Length of holder
HolderLen1=1.5
HolderLen2=1.1
HolderLen3=0.925
# PCB parameters
# Thickness of the PCB
PCBTh=0.4
# Overlap of the cameras
CameraOverlap=0.4
# Radius of holes in PCB
PCBHoleR=0.15
# Radius of screws in PCB
PCBScrewR=0.3
# Thickness of screws 
PCBScrewTh=0.3
# Position of screws
PCBScrewX=0.55
PCBScrewZ=0.55
# Gap between camera and housing
InnerGap=0.15
# Gap between top of camera and housing
InnerGap2=0.15
# Number of cameras
NCameras=32
#NCameras=4
# Thickness of housing
CoverTh=0.2
# Material of housing tof_polyethylene, tof_polypropylene, tof_aluminum or
# tof_tungsten ;-) can be used
CoverMat=tof_aluminum
# Size of cover
CoverSizeX=9.6
#CoverSizeZ=30.0
CoverSizeZ=150.0
# Size of the PCB
#PCBSizeZ=32.0
PCBSizeZ=170.0
# Distanse between cover edge and screw center
CoverScrewD=0.4
# Screw hole radius
CoverHoleR=0.15
# Screw radius
CoverScrewR=0.3
# Screw thickness
CoverScrewTh=0.3
# Distance from center of the module to 2 addition screws
CoverAddHoleD=2.0
# Number of holes in module: on X and Z
CoverHolesX=4
CoverHolesZ=41
#CoverHolesZ=7
# Container sizes
# An old version
#ContainerR1=46.2
#ContainerR2=50.0
#ContainerR3=54.0
ContainerR1=42.59
#R2 now a dummy variable. Not used
ContainerR2=44.0
ContainerR3=49.6
# Distance from beam axis to center of modules
ModuleR1=44.26
ModuleR2=47.74
# Number of modules per ring
NModules=28
# Some beauty
Beauty=0

