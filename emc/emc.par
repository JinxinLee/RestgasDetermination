#################################################################
# Digitisation and reconstruction parameters for EMC
# Format:
# parameter_name:parameter_type(i-integer, d-double) parameter_value
# PndEmcDigiPar
# Description of parameters
# EnergyHitThreshold - energy threshold used in PndEmcHitProducer.cxx, with following full digitization should be 0.
# EnergyDigiThreshold - treshold for EmcDigi energy in PndEmcWaveformToDigi.cxx
# EmcClusterPosMethod: lilo, linear
# UseDigiEffectiveSmearing: 0 - energy of hit is copied to digi, 1 - smear energy as sigma/E= a/sqrt(E) + b
#################################################################
[PndEmcDigiPar]
EnergyHitThreshold:d 0.000001
NBits:i 14
DetectedPhotonsPerMeV:d 150
EnergyRange:d 15
ExcessNoiseFactor:d 1.38
FirstSamplePhase:d 0
Number_of_samples_in_waveform:i 64
Shaping_diff_time:d 100e-9
Shaping_int_time:d 500e-9
Crystal_time_constant:d 12e-9
Incoherent_elec_noise_width_GeV:d 1.0e-3
SampleRate:d 80e6
Use_shaped_noise:i 1
Use_photon_statistic:i 1
EnergyDigiThreshold:d 3.0e-3
MapperVersion:i 2
UseDigiEffectiveSmearing:i 0
SigmaEa:d 1.86
SigmaEb:d 0.65
#################################################################
# Reconstruction parameter for EMC
# PndEmcRecoPar
#################################################################
[PndEmcRecoPar]
EnergyThresholdBarrel:d 3.0e-3
EnergyThresholdFWD:d 3.0e-3
EnergyThresholdBWD:d 3.0e-3
EnergyThresholdShashlyk:d 3.0e-3
EmcClusterPosMethod:s lilo
OffsetParmA:d 3.6
OffsetParmB:d 1.594
OffsetParmC:d 2.543
EmcDigiPositionDepth:d 6.2
MaxECut:d 0.02
NeighbourECut:d 0.002
CutSlope:d 0.5
CutOffset:d 2.5
ERatioCorr:d 0.0
TheNeighbourLevel:i 0
MoliereRadius:d 2.0
ExponentialConstant:d 2.5
MaxIterations:i 10
CentroidShift:d 0.1
MaxBumps:i 8
MinDigiEnergy:d 20.e-6