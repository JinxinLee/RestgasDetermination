#
# Example job description file with BARRIER. First, the workers produce 
# a simple histogram using the fillhisto.sh script. After a BARRIER, one of
# workers adds all histograms up using the addhisto.sh script.
#
# JOB Multiplicity ScriptToRun Input Output Number_of_pars par1 par2 par3	...
#
MOVECMD $HOME/bin/movefiles
#
SCRATCH /tmp
#
RUNID 0
JOB 100 $HOME/scripts/fillhisto.sh NULL $HOME/output/parts 3 1000000 1000 output.root
#
# Make sure that all the workers finish before carrying out the last merging
# job, hence: BARRIER
#
BARRIER
RUNID 1000
JOB 1 $HOME/scripts/addhisto.sh $HOME/output/parts $HOME/output/ 2 output.root sum.root
