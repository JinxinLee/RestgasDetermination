

Decay pbarpSystem
  0.5 D_s0*+ D_s-   PHSP;
  0.5 D_s0*- D_s+   PHSP;
Enddecay
#
Decay D_s0*+
  1.0 D_s+ pi0      PHSP;
Enddecay
#
Decay D_s0*-
  1.0 D_s- pi0      PHSP;
Enddecay
#
Decay D_s+
  1.0 phi pi+       PHSP;
Enddecay
#
Decay D_s-
  1.0 phi pi-       PHSP;
Enddecay
#
Decay phi
  1.0 K+  K-         VSS;
Enddecay
#
Decay pi0
  1.0 gamma gamma         PHSP;
Enddecay
#

End
