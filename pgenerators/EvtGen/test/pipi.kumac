i=1
nt/crea [i] Test 3 ' ' 1000 tcp ttag tag
nt/read [i] pipi.dat
zone 1 2 
hi/create/1d 101 'B0  -> pi+ pi-' 100 -5.0 5.0
hi/create/1d 102 'B0B -> pi+ pi-' 100 -5.0 5.0
nt/proj 101 [i].tcp-ttag abs(tag-36.0)<0.5
nt/proj 102 [i].tcp-ttag abs(tag-35.0)<0.5
|hi/pl 101
|hi/pl 102
|wait
hi/create/1d 201 'NB0-NB0B (pi+ pi-)' 100 -5.0 5.0
hi/create/1d 301 'NB0+NB0B (pi+ pi-)' 100 -5.0 5.0
hi/create/1d 401 '(NB0-NB0B)/(NB0+NB0B) (pi+ pi-)' 100 -5.0 5.0
hi/opera/subtract 101 102 201
hi/opera/add 101 102 301
hi/opera/divide 201 301 401
|
for/file 66 pipi.ps
meta 66 -111
zone 1 3
opt liny
hi/pl 101
hi/pl 102
hi/pl 401
|mixing = 0.0, r_cp=1/2, cp odd state
|func/plot (1-(1/2)**2)/(1+(1/2)**2)*cos(1.67*x) -5 5 s
|mixing = 0.4, r_cp=0.0, cp odd state
|func/plot sin(2*0.4)*sin(1.67*x) -5 5 s
func/plot  (1-(1/2)**2)/(1+(1/2)**2)*cos(1.67*x)+sin(2*0.4)*sin(1.67*x)/(1+(1/2)**2) -5 5 s
for/close 66


