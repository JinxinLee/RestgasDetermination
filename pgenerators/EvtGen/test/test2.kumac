hi/file 1 test2.hst
zon 2 2
opt nsta
opt utit
!set cfon -20    !Comment font
!set tfon -20    !Title font
!set lfon -20    !axis Label font
!set vfon -20    !axis Values font
!set gfon -20    !Global title font
!set gsiz .6     !Global font size
set ygti 1.0    !distance between global title and top
set ymgu 2.6    !upper plot margin
set ymgl 2.6    !lower plot margin
set xmgl 2.7    !left plot margin
set xmgr 2.5    !right plot margin
set vsiz .4     !axis values size
set asiz .5     !axis lable size
set yhti 0.9
set ylab 0.9
set xlab 0.9
set bwid 6.
set ndvx 505.
set ndvy 503.
igset txfp -20
set hcol 4
hi/pl 3
atitle '[D]t mm/c' ' '
hi/pl 6
atitle '[v]'
hi/pl 30 box
atitle '[D]t"L#0         [v]' 'cos[Q]?K*!'
hi/pl 31 box
atitle '[D]t"G#0         [v]' 'cos[Q]?K*!'



