hi/fil 1 svscplh.hst

* par1 is a norm
*    2 is tau
*    3 is dgamma
*    4 is qoverp (mag)
*    5 is qoverp (phase)
*    6 is dm

vec/create par(6) R 1000 1.56 0.32 1.0 -0.77 0.472
vec/create step(6) R 100 0.0 0.01 0.01 0.01 0.01
vec/create pmin(6)
vec/create pmax(6)

vec/create b0b0b(1) R 1.0
hi/fit 2 cpdgamma.f BLE 6 par step pmin pmax
wait
*Im not sure that the b0b0b is working yet....
vec/create b0b0b(1) R -1.0
hi/fit 3 cpdgamma.f BLE 6 par step pmin pmax

close 0