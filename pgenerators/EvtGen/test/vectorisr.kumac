# Author: Joe Izen Univ. of Texas at Dallas  7 Jul 2000
/macro/trace on

close 1
h/file 1 vectorisr.hst
for/file 90 vectorisr.ps
meta 90

opt nbox
set cfon -130
set gfon -130
set lfon -130
set tfon -130
set vfon -130

zone 3 3
opt stat
h/pl 1
opt nsta
h/pl 2
h/pl 3
h/pl 5 surf
h/pl 4
h/pl 6 surf
h/pl 7 surf
h/pl 8
h/pl 10 surf

close 90
/macro/trace/off

