hi/file 1 d2pi.hst
opt nsta
set ygti 1.0    !distance between global title and top
set ymgu 2.6    !upper plot margin
set ymgl 2.6    !lower plot margin
set xmgl 2.7    !left plot margin
set xmgr 2.5    !right plot margin
set vsiz .4     !axis values size
set asiz .3     !axis lable size
set tsiz .3
set ylab 1.0
set xlab 1.0
set yhti 1.0
set bwid 6.
set ndvx 505.
set ndvy 503.
igset txfp -20
set hcol 4
set xsiz 15
set ysiz 10
zon 2 1
hi/pl 1
opt utit
hi/pl 3
atitle 'P?[p]! in B frame (GeV)'




