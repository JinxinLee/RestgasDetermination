nt/crea 1 Test 3 ' ' 1000 tcp ttag tag
nt/read 1 cptest.dat
zone 1 2 
hi/create/1d 101 'B0(dt=0)  -> cp mode' 100 -5.0 5.0
hi/create/1d 102 'B0B(dt=0) -> cp mode' 100 -5.0 5.0
nt/proj 101 1.tcp-ttag abs(tag-36.0)<0.5
nt/proj 102 1.tcp-ttag abs(tag-35.0)<0.5
hi/pl 101
atitle 'dt (mm/c)' 'Events' 
hi/pl 102
atitle 'dt (mm/c)' 'Events'

