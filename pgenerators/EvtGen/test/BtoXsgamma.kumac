trace on
opt stat
set csiz 0.5
filecase keep
h/fil 1 BtoXsgamma.hst
*h/fil 1 B0B0bar_Kstgamma.hbook
n/cuts $1 pengcount.eq.1
h/l
n/prin 1
zone 2 4
n/pl 1.pengcount 
n/pl 1.bId $1
n/pl 1.Bmulti $1
n/pl 1.XsId $1.and.Xsid.gt.0
n/pl 1.Xsid $1.and.Xsid.lt.0
n/pl 1.XsMass $1
n/pl 1.Xsmulti $1
n/pl 1.genergy $1
*pic/print pengplots.gif
