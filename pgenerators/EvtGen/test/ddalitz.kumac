hi/file 1 ddalitz.hst
opt nsta
opt utit
set ygti 1.0    !distance between global title and top
set ymgu 2.6    !upper plot margin
set ymgl 2.6    !lower plot margin
set xmgl 2.7    !left plot margin
set xmgr 2.5    !right plot margin
set vsiz .4     !axis values size
set asiz .5     !axis lable size
set ylab 1.0
set xlab 1.0
set bwid 6.
set ndvx 505.
set ndvy 505.
igset txfp -20
set hcol 4
set xsiz 15
set ysiz 15
zon 1 1
hi/pl 1 
atitle 'm^2!(K^-![p]^0!) GeV^2!' 'm^2!(K^-![p]^+!) GeV^2!'





