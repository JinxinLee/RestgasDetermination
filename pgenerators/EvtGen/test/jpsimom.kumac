
exec beautify.kumac


nbin=25
vec/create mom([nbin])
vec/create cent([nbin])
vec/create err([nbin])
vec/create j1([nbin])
vec/create j2([nbin])

vec/create zero([nbin])

vec/read mom,cent,err,j1,j2 pstarjpsi100mev.txt

title ' '

null 0 2.5 -0.002 0.12
hplot/err mom cent zero err 25 21

line 0 0 2.5 0


hi/fil 1 generic.hst

hi/copy 5 1000
norm 1000 1
hi/plot 1000 s
atitle 'JPsi momentum' 'Fraction of events' ! 220

close 1
