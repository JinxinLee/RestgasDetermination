#################################################################
# Digitization parameters for LUMI
# Format:
# parameter_name:parameter_type(i-integer, d-double) parameter_value
# PndLumiDigiPara
# Description of parameters:
#################################################################
#################################################################
# Digitization parameters for Lumi strip sensors
#################################################################
# threshold set to 3*sigmaNoise
[LumiStripDigiPara]
pitch:Double_t 0.005
front_orient:Double_t 0.5235987755982988527
back_orient:Double_t -1.047197551196597705
front_anchor_x:Double_t 2.0
front_anchor_y:Double_t 0.0
back_anchor_x:Double_t 0.0
back_anchor_y:Double_t 0.0
charge_threshold:Double_t 15000
charge_noise:Double_t 3000
gaus_sigma:Double_t 0.0008
sens_type:Text_t 2222222222222222
#nr_fe_channels:Int_t 128


