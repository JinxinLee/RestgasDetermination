   #  cd ${VMCWORKDIR}/macro/lmd
   #  mv ${path}/Lumi_out_MC_and_REC_trks_matches_with_IDs0.root ${path}/Lumi_out_MC_and_REC_trks_matches_with_IDs0_CA_${numTrks}trks_mergedHits_${mergedHits}_addMS_${addMS}_KalmanFillter_${pbeam}.root
