for pbeam in 15
do
momStr=`echo $pbeam | sed -e '{ s/\./_/g; }'`
pathG=${VMCWORKDIR}/macro/lmd/tmpOutnewDesign/noFilterInCA_4aTaskForAll/mom_${momStr}/
mkdir -p ${pathG}
  #for numTrks in 20 1 2 3 4 5 7 10 15
