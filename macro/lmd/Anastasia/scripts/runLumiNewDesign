     mv ${path}/Lumi_QA_0.root ${path}/Lumi_QA_CA_${numTrks}trks_mergedHits_${mergedHits}_addMS_${addMS}_MinuitFit.root

    # ##Trk-Follow & Minuit
     trkCandcut=true
    root -l -b -q runLumiPixel3Finder.C\(${numEv},0,"\"${path}\"",0,"\"Follow\"",true,${mergedHits},${trkCandcut}\) &> ${path}/logPixel_Follow_${numTrks}trks_mergedHits_${pbeam}GeV
    root -l -b -q runLumiPixel4Fitter.C\(${numEv},0,"\"${path}\"",0,${mergedHits}\)
   ### Filter tracks
    root -l -b -q runLumiPixel4aFilter.C\(${numEv},0,"\"${path}\"",0,${mergedHits}\)  
# &> ${path}/logFilterFollow_${numTrks}trks
