 #    root -l -b -q runLumiPixel3Finder.C\(10000,0,"\"${path}\"",0,"\"Follow\""\) >> logNEW_Follow_${numTrks}trks
 #    root -l -b -q runLumiPixel4Fitter.C\(10000,0,"\"${path}\""\)
