for pbeam in 15
do
    root -l -b -q runLumiPixel0SimBox.C\(10000,${pbeam},"\"${path}\"",0,-2212,${numTrks}\)
    root -l -b -q runLumiPixel1Digi.C\(10000,0,"\"${path}\""\)
    root -l -b -q runLumiPixel2Reco.C\(10000,0,"\"${path}\""\)
    root -l -b -q runLumiPixel2bHitMerge.C\(10000,0,"\"${path}\""\)
    root -l -b -q runLumiPixel3Finder.C\(10000,0,"\"${path}\"",0,"\"CA\"",true\) >> logNEW_CA_${numTrks}trks
    root -l -b -q runLumiPixel4Fitter.C\(10000,0,"\"${path}\""\)
    root -l -b -q runLumi5Geane.C\(10000,${pbeam},0,"\"${path}\"",0,1\)
 #   root -l -b -q runLumi7QA.C\(100000,0,"\"${path}\""\)
    cd ${VMCWORKDIR}/build/bin
    ./rec_mc_match -s 0 -n 10000 -t ${numTrks} -mom ${pbeam} -npx 1 -v 0 -path ${path}
