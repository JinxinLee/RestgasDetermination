#################################################################
# Digitization parameters for LMD
# Format:
# parameter_name:parameter_type(i-integer, d-double) parameter_value
# PndLmdDigiPar
# Description of parameters:
#################################################################
#################################################################
# Digitization parameters for RECTANGULAR Lmd strip sensors
#################################################################
# threshold set to 5*sigmaNoise (noise rate ~ DPM signals rate)
[SDSStripDigiParRect]
top_pitch:Double_t 0.0130
bot_pitch:Double_t 0.0130
orient:Double_t 1.570796327
skew:Double_t -1.570796327
top_anchor_x:Double_t -3.3345
top_anchor_y:Double_t 1.6705
bot_anchor_x:Double_t -3.3345
bot_anchor_y:Double_t 1.6705
nr_fe_channels:Int_t 128
nr_fe_top:Int_t 4
nr_fe_bottom:Int_t 2
charge_threshold:Double_t 5000
charge_noise:Double_t 1000
QCloudSigma:Double_t 0.0008
sens_Type:Text_t Rect
fe_Type:Text_t APV25
fe_BusClock:Double_t 30
cluster_mod:Int_t 0
cluster_mean:Int_t 1
cluster_radchan:Int_t 2
cluster_radtime:Int_t 0
cluster_corrchargecut:Double_t 12000.
cluster_singlechargecut:Double_t 3000.
chargeconv_method:Int_t 0
#################################################################
# Digitization parameters for TRAPEZOID Lmd strip sensors
#################################################################
# threshold set to 5*sigmaNoise (noise rate ~ DPM signals rate)
# orient:Double_t 1.178097245
# skew:Double_t 0.785398164
# orient:Double_t 1.570796327
# skew:Double_t -1.570796327
# top_pitch:Double_t 0.005
# bot_pitch:Double_t 0.005
# nr_fe_channels:Int_t 384
[SDSStripDigiParTrap]
top_pitch:Double_t 0.005
bot_pitch:Double_t 0.005
orient:Double_t 1.178097245
skew:Double_t 0.785398164
top_anchor_x:Double_t -4.142135624
top_anchor_y:Double_t 3.5
bot_anchor_x:Double_t -4.142135624
bot_anchor_y:Double_t 3.5
nr_fe_channels:Int_t 384
nr_fe_top:Int_t 4
nr_fe_bottom:Int_t 4
charge_threshold:Double_t 5000
charge_noise:Double_t 1000
QCloudSigma:Double_t 0.0008
sens_Type:Text_t Trap
fe_Type:Text_t APV25
fe_BusClock:Double_t 30
cluster_mod:Int_t 0
cluster_mean:Int_t 1
cluster_radchan:Int_t 2
cluster_radtime:Int_t 0
cluster_corrchargecut:Double_t 12000.
cluster_singlechargecut:Double_t 3000.
chargeconv_method:Int_t 0
#################################################################
# Digitization parameters for RECTANGULAR double-sided
# strip sensors used in the tracking station.
#################################################################
# threshold set to 5*sigmaNoise (noise rate ~ DPM signals rate)
[SDSStripDigiParTD]
top_pitch:Double_t 0.0050
bot_pitch:Double_t 0.0050
orient:Double_t 1.570796327
skew:Double_t -1.570796327
top_anchor_x:Double_t -0.9575
top_anchor_y:Double_t 0.9575
bot_anchor_x:Double_t -0.9575
bot_anchor_y:Double_t 0.9575
nr_fe_channels:Int_t 128
nr_fe_top:Int_t 3
nr_fe_bottom:Int_t 3
charge_threshold:Double_t 5000
charge_noise:Double_t 1000
QCloudSigma:Double_t 0.0008
sens_Type:Text_t TD
fe_Type:Text_t APV25
fe_BusClock:Double_t 30
cluster_mod:Int_t 0
cluster_mean:Int_t 1
cluster_radchan:Int_t 2
cluster_radtime:Int_t 0
cluster_corrchargecut:Double_t 1200.
cluster_singlechargecut:Double_t 1000.
chargeconv_method:Int_t 0
#################################################################
# Digitization parameters for RECTANGULAR single-sided
# strip sensors used in the tracking station.
#################################################################
# threshold set to 5*sigmaNoise (noise rate ~ DPM signals rate)
[SDSStripDigiParTS]
top_pitch:Double_t 0.0050
bot_pitch:Double_t 1.9200
orient:Double_t 1.570796327
skew:Double_t -1.570796327
top_anchor_x:Double_t -0.9575
top_anchor_y:Double_t 0.9575
bot_anchor_x:Double_t 0.
bot_anchor_y:Double_t 0.9575
nr_fe_channels:Int_t 128
nr_fe_top:Int_t 3
nr_fe_bottom:Int_t 1
charge_threshold:Double_t 5000
charge_noise:Double_t 1000
QCloudSigma:Double_t 0.0008
sens_Type:Text_t TS
fe_Type:Text_t APV25
fe_BusClock:Double_t 30
cluster_mod:Int_t 0
cluster_mean:Int_t 1
cluster_radchan:Int_t 2
cluster_radtime:Int_t 0
cluster_corrchargecut:Double_t 1200.
cluster_singlechargecut:Double_t 1000.
chargeconv_method:Int_t 0
#################################################################
# Digitization Parameters for SDS Pixel
#################################################################
# threshold set to 6 sigma (noise rate ~ DPM signals rate)
[SDSPixelDigiPar]
dimX:Double_t 0.008
dimY:Double_t 0.008
threshold:Double_t 500
noise:Double_t 200
QCloudSigma:Double_t 0.0008
FECols:Int_t 250
FERows:Int_t 250
ClustRad:Double_t 1.8
chargeconv_method:Int_t 0
fe_BusClock:Double_t 155.52
PixelSorterCellWidth:Double_t 10
PixelSorterNumberOfCells:Int_t 1000
#################################################################
#################################################################
# Charge to Tot Digitization parameters for SDS
# parameter_name:parameter_type(i-integer, d-double) parameter_value
# PndLmdTotDigiPar
#################################################################
# Digitization Parameters for SDS Pixel
#################################################################
[SDSPixelTotDigiPar]
charge_time:Double_t 100
const_current:Double_t 60
clock_frequency:Double_t 50
#################################################################
#################################################################
# Digitization parameters for RECTANGULAR Lmd strip sensors
#################################################################
[SDSStripTotDigiParRect]
charge_time:Double_t 100.
const_current:Double_t 60.
clock_frequency:Double_t 50.
#################################################################
# Digitization parameters for TRAPEZOID Lmd strip sensors
#################################################################
[SDSStripTotDigiParTrap]
charge_time:Double_t 100.
const_current:Double_t 60.
clock_frequency:Double_t 50.
#################################################################
# Digitization parameters for RECTANGULAR double-sided
# strip sensors used in the tracking station.
#################################################################
[SDSStripTotDigiParTD]
charge_time:Double_t 100.
const_current:Double_t 60.
clock_frequency:Double_t 50.
#################################################################
# Digitization parameters for RECTANGULAR single-sided
# strip sensors used in the tracking station.
#################################################################
[SDSStripTotDigiParTS]
charge_time:Double_t 100.
const_current:Double_t 60.
clock_frequency:Double_t 50.
#################################################################
[SDSStriDummy]
charge_time:Double_t 100.
const_current:Double_t 60.
clock_frequency:Double_t 50.
#################################################################