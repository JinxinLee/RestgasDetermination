#	pathname=/data/FAIRsorf/pandaroot/trunk/macro/lmd/tmpOutputAlign/results/misalign${ARRAYA[${ia}]}_10e-3radDOF000111_${ARRAY[${i}]}_events
	resfile=/data/FAIRsorf/pandaroot/trunk/macro/lmd/tmpOutputAlign/results/Sens.root
	time root -l -b -q GenAlignEffect.C\(\"${pathname}/\",${ARRAYD[${j}]},${j},${ELEMENTSD},\"${resfile}\"\)
# # #---------------------------------------------------------------------- 
	 done
     done
 done
echo "results saved in " ${pathname}
exit
