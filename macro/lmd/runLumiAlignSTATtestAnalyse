#!/bin/bash


#numer of events used for resolution study
SIMEVENTS=100000
ARRAY=(100000)
# get number of elements in the array
ELEMENTS=${#ARRAY[@]}

#Declare array with elements for misalignment scale
ARRAYD=(0 20 30 50 70 100 150 200 250 300 350 400 450 500) #mum
