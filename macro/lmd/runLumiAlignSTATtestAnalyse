ELEMENTSD=${#ARRAYD[@]}
#ARRAYA=(1 3 5 7 10 20) # 1e-3 rad
ARRAYA=(0) # 1e-3 rad
# get number of elements in the array
ELEMENTSA=${#ARRAYA[@]}
#CRFILE=(0 1 1 1 1 1 1 1) #mum
# echo each element in array 
# for loop
 for (( j=0;j<$ELEMENTSD;j++)); do
     for (( ia=0;ia<$ELEMENTSA;ia++)); do
