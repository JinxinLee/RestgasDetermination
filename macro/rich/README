FAST simulation without optical physics: (used for analisis)

1. sim_complite.C

  // Create the Simulation run manager--------------------------------
  FairRunSim *fRun = new FairRunSim();
  ...
  //fRun->SetUserConfig("g4Config_opt.C");
  ...
  
  //-------------------------  RICH       ----------------
  PndRich *Rich= new PndRich("RICH",kTRUE);
  Rich->SetGeometryFileName("rich_v313.root");
  //Rich->SetRunCherenkov(kTRUE);
  fRun->AddModule(Rich);

2. digi_complite.C

  // -----   RICH hit producers   ---------------------------------
  PndRichHitProducer* richhit = new PndRichHitProducer();
  richhit->SetVerbose(iVerbose);
  //richhit->SetPhDetNoiseON(kTRUE);
  fRun->AddTask(richhit);
   
