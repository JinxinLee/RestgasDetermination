noPhotos

Alias 	MyDsp		D_s+
Alias	MyDsm		D_s-
Alias 	MyDspst		D_s*+
Alias	MyDsmst		D_s*-

Decay pbarpSystem0
	0.25 	D_s+    MyDsmst   	PHSP;
	0.25 	D_s-    MyDspst   	PHSP;
	0.25 	MyDsp   D_s*-   	PHSP;
	0.25 	MyDsm   D_s*+   	PHSP;
Enddecay

Decay pbarpSystem
	0.25 	D_s+    MyDsmst   	PHSP;
	0.25 	D_s-    MyDspst   	PHSP;
	0.25 	MyDsp   D_s*-   	PHSP;
	0.25 	MyDsm   D_s*+   	PHSP;
Enddecay

Decay MyDspst
  0.942   MyDsp  gamma			VSP_PWAVE;
  0.058   MyDsp  pi0			VSS;
Enddecay

Decay MyDsmst
  0.942   MyDsm  gamma			VSP_PWAVE;
  0.058   MyDsm  pi0			VSS;
Enddecay

Decay MyDsp
  	1.0 	K+ K- pi+			DS_DALITZ;
Enddecay

Decay MyDsm
  	1.0 	K+ K- pi-			DS_DALITZ;
Enddecay

End
