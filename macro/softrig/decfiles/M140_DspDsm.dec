Alias 	MyDsp	D_s+
Alias	MyDsm	D_s-

Decay pbarpSystem0
	0.5 	D_s+ MyDsm   	PHSP;
	0.5 	D_s- MyDsp   	PHSP;
Enddecay

Decay pbarpSystem
	0.5 	D_s+ MyDsm   	PHSP;
	0.5 	D_s- MyDsp   	PHSP;
Enddecay

Decay MyDsp
  	1.0 	K+ K- pi+			DS_DALITZ;
Enddecay

Decay MyDsm
  	1.0 	K+ K- pi-			DS_DALITZ;
Enddecay

End
