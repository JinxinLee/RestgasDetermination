noPhotos

Alias 	MyDp	D+
Alias	MyDm	D-
Alias 	MyDpst	D*+
Alias	MyDmst	D*-
Alias   MyKs    K_S0

Decay pbarpSystem0
  0.25  MyDp    D*-			PHSP;
  0.25  MyDm    D*+			PHSP;
  0.25  D+      MyDmst		PHSP;
  0.25  D-  	MyDpst		PHSP;
Enddecay

Decay pbarpSystem
  0.25  MyDp    D*-			PHSP;
  0.25  MyDm    D*+			PHSP;
  0.25  D+      MyDmst		PHSP;
  0.25  D-  	MyDpst		PHSP;
Enddecay

Decay MyDpst
#  0.6830    D0  pi+		VSS;
  0.3060    MyDp  pi0		VSS;
  0.0110    MyDp  gamma		VSP_PWAVE;
Enddecay

Decay MyDmst
#  0.6830    anti-D0 pi-	VSS;
  0.3060    MyDm  pi0		VSS;
  0.0110    MyDm  gamma		VSP_PWAVE;
Enddecay

Decay MyDp
  1.0 	MyKs pi+ pi+ pi-		PHSP;
Enddecay

Decay MyDm
  1.0 	MyKs pi- pi- pi+		PHSP;
Enddecay

Decay MyKs
  1.0   pi+ pi-					PHSP;
Enddecay

End
