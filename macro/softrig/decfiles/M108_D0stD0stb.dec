Alias 	MyD0		D0
Alias	MyD0b		anti-D0
Alias   MyD0st   	D*0
Alias   MyD0stb		anti-D*0

Decay pbarpSystem
  0.5  MyD0st  anti-D*0		PHSP;
  0.5  D*0     MyD0stb		PHSP;
Enddecay

Decay pbarpSystem0
  0.5  MyD0st  anti-D*0		PHSP;
  0.5  D*0     MyD0stb		PHSP;
Enddecay

Decay MyD0st
  0.6190    MyD0  pi0			VSS;
  0.3810    MyD0  gamma			VSP_PWAVE;
Enddecay

Decay MyD0stb
  0.6190    MyD0b  pi0			VSS;
  0.3810    MyD0b  gamma		VSP_PWAVE;
Enddecay

Decay MyD0
  1.0 	K- pi+ pi+ pi- 		PHSP;
Enddecay

Decay MyD0b
  1.0 	K+ pi- pi- pi+ 		PHSP;
Enddecay

End
