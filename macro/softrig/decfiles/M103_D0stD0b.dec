Alias 	MyD0		D0
Alias	MyD0b		anti-D0
Alias   MyD0st   	D*0
Alias   MyD0stb		anti-D*0

Decay pbarpSystem
  0.25  MyD0     anti-D*0		PHSP;
  0.25  MyD0b    D*0			PHSP;
  0.25  D0       MyD0stb		PHSP;
  0.25  anti-D0  MyD0st			PHSP;
Enddecay

Decay pbarpSystem0
  0.25  MyD0     anti-D*0		PHSP;
  0.25  MyD0b    D*0			PHSP;
  0.25  D0       MyD0stb		PHSP;
  0.25  anti-D0  MyD0st			PHSP;
Enddecay

Decay MyD0st
  0.6190    MyD0  pi0			VSS;
  0.3810    MyD0  gamma			VSP_PWAVE;
Enddecay

Decay MyD0stb
  0.6190    MyD0b  pi0			VSS;
  0.3810    MyD0b  gamma		VSP_PWAVE;
Enddecay

Decay MyD0
  1.0 	K- pi+		PHSP;
Enddecay

Decay MyD0b
  1.0 	K+ pi-		PHSP;
Enddecay

End
