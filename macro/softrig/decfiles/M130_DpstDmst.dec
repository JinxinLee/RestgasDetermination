Alias 	MyDp	D+
Alias	MyDm	D-
Alias 	MyDpst	D*+
Alias	MyDmst	D*-
Alias   MyKs    K_S0

Decay pbarpSystem0
  0.5  MyDpst    D*-		PHSP;
  0.5  MyDmst    D*+		PHSP;
Enddecay

Decay pbarpSystem
  0.5  MyDpst    D*-		PHSP;
  0.5  MyDmst    D*+		PHSP;
Enddecay

Decay MyDpst
#  0.6830    D0  pi+		VSS;
  0.3060    MyDp  pi0		VSS;
  0.0110    MyDp  gamma		VSP_PWAVE;
Enddecay

Decay MyDmst
#  0.6830    anti-D0 pi-	VSS;
  0.3060    MyDm  pi0		VSS;
  0.0110    MyDm  gamma		VSP_PWAVE;
Enddecay

Decay MyDp
  1.0  MyKs pi+ pi0		PHSP;
Enddecay

Decay MyDm
  1.0 	MyKs pi- pi0		PHSP;
Enddecay

Decay MyKs
  1.0   pi+ pi-					PHSP;
Enddecay

End
